# Postgres connection string.
DATABASE_URL=postgresql://whatsapp:whatsapp@localhost:5432/whatsapp

# Encrypts WhatsApp credentials and QR codes at rest. Required, at least 32 characters.
# Generate with: openssl rand -base64 32
# Losing it means every number must be paired again.
SECRET=

# HTTP API.
PORT=3000

# Where received and uploaded files are stored (must be shared by the api and the worker).
MEDIA_DIR=./data/media
MAX_MEDIA_MB=20

# Worker.
# Which session (WhatsApp number) this worker process serves. Run one worker per session.
SESSION_ID=1
# Minimum pause between outgoing messages from one number, in milliseconds. Do not set it too low.
SEND_DELAY_MS=2000
# Also record group conversations (default: groups are ignored).
INCLUDE_GROUPS=false

# Webhooks to private/loopback addresses are blocked unless you set this to true (useful only for local development).
ALLOW_PRIVATE_WEBHOOKS=false
